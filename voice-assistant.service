# Install as a *user* service so it can use your audio session (PipeWire/ALSA):
#   mkdir -p ~/.config/systemd/user
#   cp voice-assistant.service ~/.config/systemd/user/
#   (edit the paths below if the project is not in ~/pi-voice)
#   systemctl --user daemon-reload
#   systemctl --user enable --now voice-assistant
#   sudo loginctl enable-linger $USER      # start at boot without logging in
#   journalctl --user -u voice-assistant -f

[Unit]
Description=Offline voice assistant
After=network.target sound.target

[Service]
WorkingDirectory=%h/pi-voice
Environment=WAKE_WORD=hey_jarvis
Environment=LLM_MODEL=qwen2.5:1.5b
# Environment=AUDIO_IN=1
# Environment=AUDIO_OUT=0
ExecStart=%h/pi-voice/.venv/bin/python assistant.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
